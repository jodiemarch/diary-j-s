# Salin file ini jadi ".env", lalu isi. Jangan pernah upload file .env ke GitHub atau tempat publik.

# Nama tampil masing-masing orang di diary
USER1_NAME=Nama Kamu
USER2_NAME=Nama Pasangan

# PIN masing-masing (minimal 6 karakter, disarankan 6+ angka, dan harus beda).
# PIN inilah yang menentukan siapa penulis entri.
USER1_PIN=
USER2_PIN=

# Kunci rahasia untuk menandatangani sesi login. Isi dengan acak panjang (minimal 32 karakter).
# Cara bikin: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port server (hosting biasanya mengisinya sendiri)
PORT=3000

# Lokasi penyimpanan database. Di hosting, arahkan ke disk yang PERMANEN (lihat README).
DATA_DIR=./data

# Aktifkan jadi 1 begitu website diakses lewat HTTPS
COOKIE_SECURE=0

# Aktifkan jadi 1 kalau di belakang proxy hosting (Render, Railway, Fly, dll), supaya batas percobaan PIN membaca IP asli
TRUST_PROXY=0
